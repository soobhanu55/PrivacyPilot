APP_NAME=DSGVO Copilot API
ENV=production
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
QDRANT_COLLECTION=dsgvo_docs
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://your-vercel-domain.vercel.app
DATABASE_URL=postgresql+asyncpg://postgres.your-supabase-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
TOKEN_REVOKE_PREFIX=dsgvo:revoked:
